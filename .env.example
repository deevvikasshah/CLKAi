# Copy to .env and fill in real values. Never commit a filled-in .env file.

# Local/dev: file-based SQLite, zero infra cost.
# Production: swap for a managed Postgres URL (e.g. Neon or Supabase free/low tier)
# and change prisma/schema.prisma's datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Random string, 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# Payment gateway (choose one; leave unset to use the mock provider in dev).
# PAYMENT_PROVIDER="razorpay"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Maps (restrict this key by HTTP referrer + Maps JavaScript API in Google Cloud Console
# before using it in production — never ship an unrestricted key).
# GOOGLE_MAPS_API_KEY=""

# Object storage for uploads in production (S3-compatible; Cloudflare R2 is a
# low-cost option). Leave unset in dev — uploads fall back to /public/uploads.
# UPLOADS_BUCKET_URL=""
# UPLOADS_ACCESS_KEY_ID=""
# UPLOADS_SECRET_ACCESS_KEY=""
